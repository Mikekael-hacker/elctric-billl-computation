    static void whatCustomer (char returnedAnswer, char returnedAnswerRightChoice, char returnedAnswerRightChoice2, char returnedAnswerRightChoice3, Scanner scanner, char customerType, char customerTypePhase, char customerTypeUsageRange, double fixedCharge) {

        System.out.print("\nWhat type of Customer are you? \n\n[R]Residential\n[C]Commercial\n[I]Industrial\n----------------------\nEnter your answer:  ");
        
        returnedAnswer = scanner.nextLine().charAt(0);
        returnedAnswer = Character.toUpperCase(returnedAnswer);
        customerType = returnedAnswer;
        if (returnedAnswer == returnedAnswerRightChoice || returnedAnswer == returnedAnswerRightChoice2 || returnedAnswer == returnedAnswerRightChoice3) {
            whatPhase(returnedAnswer, scanner, customerType, customerTypeUsageRange);
        }
        else {
            wrongInput(returnedAnswer, returnedAnswerRightChoice, returnedAnswerRightChoice2, returnedAnswerRightChoice3, scanner, customerType, customerTypePhase, customerTypeUsageRange, fixedCharge);
        }

    }
    static void whatPhase (char returnedAnswer, Scanner scanner, char customerType, char customerTypeUsageRange) {

        System.out.print("\nWhat is your connection type?\n[S]Single Phase\n[T]Three Phase\n---------------------\nEnter your answer:  ");
        returnedAnswer = scanner.nextLine().charAt(0);
        returnedAnswer = Character.toUpperCase(returnedAnswer);
        answerPhase(returnedAnswer, scanner, customerType, customerTypeUsageRange);

    }

    static void answerPhase (char returnedAnswer, Scanner scanner, char customerType, char customerTypeUsageRange) {

        char returnedAnswerRightChoice = 'S', returnedAnswerRightChoice2 = 'T', returnedAnswerRightChoice3 = '~', customerTypePhase;
        customerTypePhase = returnedAnswer;
        double fixedCharge = 0;

        if (returnedAnswer != returnedAnswerRightChoice && returnedAnswer != returnedAnswerRightChoice2) {
            wrongInput(returnedAnswer, returnedAnswerRightChoice, returnedAnswerRightChoice2, returnedAnswerRightChoice3, scanner, customerType, customerTypePhase, customerTypeUsageRange, fixedCharge);
        }
        else {
            if (returnedAnswer == returnedAnswerRightChoice) {
                fixedCharge = 100.00;
            }
            else {
                fixedCharge = 250.00;
            }
            usageRange(returnedAnswer, scanner, customerType, customerTypePhase, fixedCharge);
        }
    } // Method bracket for answerPhase

    static void usageRange (char returnedAnswer, Scanner scanner, char customerType, char customerTypePhase, double fixedCharge) {

        char returnedAnswerRightChoice = '1', returnedAnswerRightChoice2 = '2', returnedAnswerRightChoice3 = '3', customerTypeUsageRange;

        System.out.print("\nWhat is your usage range?\n[1] 1 - 100\n[2] 101 - 300\n[3] Above 300\n----------------------\nEnter your answer:  ");
        returnedAnswer = scanner.nextLine().charAt(0);
        customerTypeUsageRange = returnedAnswer;
        answerRange(returnedAnswer, returnedAnswerRightChoice, returnedAnswerRightChoice2, returnedAnswerRightChoice3, customerType, customerTypePhase, customerTypeUsageRange, scanner, fixedCharge);
    }
    static void answerRange (char returnedAnswer, char returnedAnswerRightChoice, char returnedAnswerRightChoice2, char returnedAnswerRightChoice3, char customerType, char customerTypePhase, char customerTypeUsageRange, Scanner scanner, double fixedCharge) {

        double answerKWH = 0, previousAnswerKWH = 0;
        int tryCounter = 0;
        char retryConfirm;

            if (returnedAnswer == returnedAnswerRightChoice) {
                System.out.print("\nHow much kWh do you use between 1 - 100?\nEnter your answer:  ");
                answerKWH = scanner.nextDouble();
                if (answerKWH < 1 || answerKWH > 100) {
                    do {
                        if (answerKWH < 1) {
                            System.out.print("Please enter a value that is above 0 kWh.\nEnter your answer:  ");
                        } else {
                            System.out.print("Please enter a value that is at most 100 kWh.\nEnter your answer:  ");
                        }
                        answerKWH = scanner.nextDouble();
                        tryCounter++;
                    } while ((answerKWH < 1 || answerKWH > 100) && tryCounter < 5);
                }
            } else if (returnedAnswer == returnedAnswerRightChoice2) {
                System.out.print("How much kWh do you use between 101 - 300?\nEnter your answer:  ");
                answerKWH = scanner.nextDouble();
                if (answerKWH < 101 || answerKWH > 300) {
                    do {
                        if (answerKWH < 101) {
                            System.out.print("Please enter a value that is above 100 kWh.\nEnter your answer:  ");
                        } else {
                            System.out.print("Please enter a value that is at most 300 kWh.\nEnter your answer:  ");
                        }
                        answerKWH = scanner.nextDouble();
                        tryCounter++;
                    } while ((answerKWH < 101 || answerKWH > 300) && tryCounter < 5);
                }
            } else if (returnedAnswer == returnedAnswerRightChoice3) {
                System.out.print("How much kWh do you use above 300?\nEnter your answer:  ");
                answerKWH = scanner.nextDouble();
                if (answerKWH < 301) {
                    do {
                        System.out.print("Please enter a value that is above 300 kWh.\nEnter your answer:  ");
                        answerKWH = scanner.nextDouble();
                        tryCounter++;
                    } while (answerKWH < 301 && tryCounter < 5);
                }
            } else {
                wrongInput(returnedAnswer, returnedAnswerRightChoice, returnedAnswerRightChoice2, returnedAnswerRightChoice3, scanner, customerType, customerTypePhase, customerTypeUsageRange, fixedCharge);
            }

            if ((answerKWH > 1 && answerKWH <= 100) || (answerKWH >= 101 && answerKWH <= 300) || (answerKWH > 300)) {
                tryCounter = 0;
            }

            scanner.nextLine();
            if (tryCounter == 5) {
                tryCounter = 0;
                do {
                    System.out.print("Too many consecutive failed attempts in a row. Do you wish to input your kWh again? Y/N?\nOptionally, you can also return to input a new usage range by returning the letter U.\nEnter your answer:  ");
                    retryConfirm = scanner.nextLine().charAt(0);
                    retryConfirm = Character.toUpperCase(retryConfirm);
                    tryCounter++;
                } while (retryConfirm != 'Y' && retryConfirm != 'N' && retryConfirm != 'U' && tryCounter < 5);

                if (tryCounter == 5) {
                    System.out.println("\nForcefully aborting due to multiple consecutive failed attempts..");
                    exitMethod(scanner);
                    return;
                }
                else {
                    if (retryConfirm == 'Y') {
                        answerRange(returnedAnswer, returnedAnswerRightChoice, returnedAnswerRightChoice2, returnedAnswerRightChoice3, customerType, customerTypePhase, customerTypeUsageRange, scanner, fixedCharge);
                    }
                    else if (retryConfirm == 'U') {
                        usageRange(returnedAnswer, scanner, customerType, customerTypePhase, fixedCharge);
                    }
                    else {
                        exitMethod(scanner);
                        return;
                    }
                }
            }
            else {
                tryCounter = 0;
                System.out.print("\nWhat is your previous kWh reading? It must not be over your present reading.\nEnter your answer:  ");
                previousAnswerKWH = scanner.nextDouble();
                if (answerKWH < 101) {
                    if (previousAnswerKWH > answerKWH || previousAnswerKWH < 0) {
                        do {
                            if (previousAnswerKWH > answerKWH) {
                                System.out.println("\nPlease enter your right kWh reading that is not over your present reading.\nPresent reading:  " + answerKWH);
                            }
                            else if (previousAnswerKWH < 0) {
                                System.out.println("\nPlease enter your right kWh reading that is not below 0.\nPresent reading:  " + answerKWH);
                            }
                            System.out.print("Enter your answer:  ");
                            previousAnswerKWH = scanner.nextDouble();
                            tryCounter++;
                        } while ((previousAnswerKWH > answerKWH || previousAnswerKWH < 0) && tryCounter < 5);
                    }
                }
                else if (answerKWH < 301) {
                    if (previousAnswerKWH > answerKWH || previousAnswerKWH < 0) {
                        do {
                            if (previousAnswerKWH > answerKWH) {
                                System.out.println("\nPlease enter your right kWh reading that is not over your present reading.\nPresent reading:  " + answerKWH);
                            }
                            else if (previousAnswerKWH < 0) {
                                System.out.println("\nPlease enter your right kWh reading that is not below 0.\nPresent reading:  " + answerKWH);
                            }
                            System.out.print("Enter your answer:  ");
                            previousAnswerKWH = scanner.nextDouble();
                            tryCounter++;
                        } while ((previousAnswerKWH > answerKWH || previousAnswerKWH < 0) && tryCounter < 5);
                    }
                }
                else {
                    if (previousAnswerKWH > answerKWH || previousAnswerKWH < 0) {
                        do {
                            if (previousAnswerKWH > answerKWH) {
                                System.out.println("\nPlease enter your right kWh reading that is not over your present reading.\nPresent reading:  " + answerKWH);
                            }
                            else if (previousAnswerKWH < 0) {
                                System.out.println("\nPlease enter your right kWh reading that is not below 0.\nPresent reading:  " + answerKWH);
                            }
                            System.out.print("Enter your answer:  ");
                            previousAnswerKWH = scanner.nextDouble();
                            tryCounter++;
                        } while ((previousAnswerKWH > answerKWH || previousAnswerKWH < 0) && tryCounter < 5);
                    }
                }
            }
            scanner.nextLine();
            if (previousAnswerKWH < answerKWH && previousAnswerKWH >= 0) {
                tryCounter = 0;
            }

            if (tryCounter == 5) {
                tryCounter = 0;
                do {
                    System.out.print("\nToo many consecutive failed attempts in a row. Do you wish to restart and input your usage category again? Y/N?\nOptionally, you may also press K to enter your kWh usage.\nEnter your answer:  ");
                    retryConfirm = scanner.nextLine().charAt(0);
                    retryConfirm = Character.toUpperCase(retryConfirm);
                    tryCounter++;
                } while (retryConfirm != 'Y' && retryConfirm != 'N' && retryConfirm != 'K' && tryCounter < 5);

                if (tryCounter == 5) {
                    System.out.println("\nForcefully aborting due to multiple consecutive failed attempts..");
                    exitMethod(scanner);
                }
                else {
                    if (retryConfirm == 'Y') {
                        usageRange(returnedAnswer, scanner, customerType, customerTypePhase, fixedCharge);
                    }
                    else if (retryConfirm == 'K') {
                        answerRange(returnedAnswer, returnedAnswerRightChoice, returnedAnswerRightChoice2, returnedAnswerRightChoice3, customerType, customerTypePhase, customerTypeUsageRange, scanner, fixedCharge);
                    }
                    else {
                        exitMethod(scanner);
                    }
                }
            }
            else {
                computationProcess(customerTypeUsageRange, answerKWH, previousAnswerKWH, returnedAnswer, returnedAnswerRightChoice, returnedAnswerRightChoice2, returnedAnswerRightChoice3, customerType, scanner, customerTypePhase, fixedCharge);
            }
    } // Method end for answerRange
    static void computationProcess (char customerTypeUsageRange, double answerKWH, double previousAnswerKWH, char returnedAnswer, char returnedAnswerRightChoice, char returnedAnswerRightChoice2, char returnedAnswerRightChoice3, char customerType, Scanner scanner, char customerTypePhase, double fixedCharge) {

        DecimalFormat decimalFormat = new DecimalFormat("0.00"); // transfer to another method
        double vaTax = 0.12, energyCharge, consumedKWH, totalBill, ratePerKWH, vaTaxTotal;
        char pesos = '₱';

        if (returnedAnswer == returnedAnswerRightChoice) {
            ratePerKWH = 10.00;
        }
        else if (returnedAnswer == returnedAnswerRightChoice2) {
            ratePerKWH = 12.00;
        }
        else {
            ratePerKWH = 15.00;
        }

        consumedKWH = answerKWH - previousAnswerKWH;
        System.out.println("\nYour consumed kWh is:  " + decimalFormat.format(consumedKWH));
        energyCharge = answerKWH * ratePerKWH;
        System.out.println("Your energy charge is:  " + pesos + decimalFormat.format(energyCharge));
        vaTaxTotal = vaTax * (energyCharge + fixedCharge);
        System.out.println("Your Value Added Tax (VAT) is:  " + pesos + decimalFormat.format(vaTaxTotal));
        totalBill = energyCharge + fixedCharge + vaTaxTotal;
        System.out.println("Your total bill is:  " + pesos + decimalFormat.format(totalBill));
        tryAgain(returnedAnswer, scanner, customerType, customerTypeUsageRange);

    }
    static void tryAgain (char returnedAnswer, Scanner scanner, char customerType, char customerTypeUsageRange) {
        System.out.print("\nWould you like to:\n[1]Try Again and input a new value\n[2]Start Over\n[3]Exit?\n\nEnter your answer:  ");
        returnedAnswer = scanner.nextLine().charAt(0);
        returnedAnswer = Character.toUpperCase(returnedAnswer);
        switch (returnedAnswer) {
            case '1':
                whatPhase(returnedAnswer, scanner, customerType, customerTypeUsageRange);
                break;
            case '2':
                main(new String[0]);
                break;
            case '3':
                exitMethod(scanner);
                break;
            default:
                int tryCounter = 0;
                do {
                    System.out.print("You have entered an invalid choice. Please input the correct choice and try again:  ");
                    returnedAnswer = scanner.nextLine().charAt(0);
                    returnedAnswer = Character.toUpperCase(returnedAnswer);
                    tryCounter++;
                } while (returnedAnswer != '1' && returnedAnswer != '2' && returnedAnswer != '3' && tryCounter < 5);

                if (tryCounter == 5) {
                    System.out.println("\nForcefully aborting due to multiple consecutive failed attempts..");
                    exitMethod(scanner);
                }
                else {
                    switch (returnedAnswer) {
                        case '1':
                            whatPhase(returnedAnswer, scanner, customerType, customerTypeUsageRange);
                            break;
                        case '2':
                            main(new String[0]);
                            break;
                        case '3':
                            exitMethod(scanner);
                            break;
                    }
                }
        }
    }
