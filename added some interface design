import java.text.DecimalFormat;
import java.util.Scanner;

public class ElectricBillComputation {
    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        char returnedAnswer = '1', returnedAnswerRightChoice = 'R', returnedAnswerRightChoice2 = 'C', returnedAnswerRightChoice3 = 'I'; // returnAnswerRightChoiceX are hard bound variables containing right answers, overwritten only when input is valid.
        char customerType = '1', customerTypeUsageRange = '1', customerTypePhase = '1'; double fixedCharge = 0; // dummies to comply with wrongInput. overwritten later

