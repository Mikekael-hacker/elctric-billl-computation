        char retryConfirm;
        int tryCounter = 0;

        if (returnedAnswerRightChoice3 != '~') {
            do {
                System.out.print("\nYou have entered an invalid choice. Please input the correct choice and try again.\nOptionally, you may enter the letter Y to return to your previous state.\nEnter your answer:   ");
                returnedAnswer = scanner.nextLine().charAt(0);
                returnedAnswer = Character.toUpperCase(returnedAnswer);
                tryCounter++;
            } while (returnedAnswer != returnedAnswerRightChoice && returnedAnswer != returnedAnswerRightChoice2 && returnedAnswer != returnedAnswerRightChoice3 && returnedAnswer != 'Y' && tryCounter < 5); // not an efficient method, I know that, but ultimately
                                                                                                                                                                                     // it is better than having another method.
        }
        else {
            do {
                System.out.print("\nYou have entered an invalid choice. Please input the correct choice and try again.\nOptionally, you may enter the letter Y to return to your previous state.\nEnter your answer:   ");
                returnedAnswer = scanner.nextLine().charAt(0);
                returnedAnswer = Character.toUpperCase(returnedAnswer);
                tryCounter++;
            } while (returnedAnswer != returnedAnswerRightChoice && returnedAnswer != returnedAnswerRightChoice2 && returnedAnswer != 'Y' && tryCounter < 5);
        }

        if (returnedAnswer == returnedAnswerRightChoice || returnedAnswer == returnedAnswerRightChoice2) {
            tryCounter = 0;
        }
        else if (returnedAnswerRightChoice3 != '~' && returnedAnswer == returnedAnswerRightChoice3) {
            tryCounter = 0;
        }

        if (tryCounter == 5) {
            System.out.print("\nYou have entered " + tryCounter + " consecutive wrong inputs. Do you wish to continue from the start? Y/N?:  ");
            retryConfirm = scanner.nextLine().charAt(0);
            retryConfirm = Character.toUpperCase(retryConfirm);
                switch (retryConfirm) {
                    case 'Y':
                        System.out.println("\nRestarting...");
                        main(new String[0]);
                        break;
                    case 'N':
                        System.out.println("\nAborting...");
                        exitMethod(scanner);
                        break;
                    default:
                        do {
                            System.out.print("Please enter a valid input to restart / not restart the program Y/N:  ");
                            retryConfirm = scanner.nextLine().charAt(0);
                            retryConfirm = Character.toUpperCase(retryConfirm);
                            tryCounter++;
                        } while (tryCounter < 10 && retryConfirm != 'Y' && retryConfirm != 'N');

                        if (retryConfirm == 'Y') {
                                System.out.println("\nRestarting...");
                                main(new String[0]);
                        }
                        else if (retryConfirm == 'N') {
                            System.out.println("\nAborting...");
                            exitMethod(scanner);
                        }
                        else {
                                System.out.println("\nForcefully Aborting due to multiple invalid inputs... Please restart the program manually.");
                                exitMethod(scanner);
                        }
                        break;
                }
            }
        else {
            if (returnedAnswer == 'R' || returnedAnswer == 'C' || returnedAnswer == 'I') {
                System.out.println("Thank you for answering correctly.\n");
                whatPhase(returnedAnswer, scanner, customerType, customerTypeUsageRange);
                }
            else if (returnedAnswer == 'S' || returnedAnswer == 'T') {
                System.out.println("Thank you for answering correctly.\n");
                answerPhase(returnedAnswer, scanner, customerType, customerTypeUsageRange);
                }
            else if (returnedAnswer == '1' || returnedAnswer == '2' || returnedAnswer == '3') {
                System.out.println("Thank you for answering correctly.\n");
                answerRange(returnedAnswer, returnedAnswerRightChoice, returnedAnswerRightChoice2, returnedAnswerRightChoice3,customerType, customerTypePhase, customerTypeUsageRange, scanner, fixedCharge);
                }
            else {
                if (returnedAnswerRightChoice == 'R') {
                    whatCustomer(returnedAnswer, returnedAnswerRightChoice, returnedAnswerRightChoice2, returnedAnswerRightChoice3, scanner, customerType, customerTypePhase, customerTypeUsageRange, fixedCharge);
                    }
                else if (returnedAnswerRightChoice == 'S') {
                    whatPhase(returnedAnswer, scanner, customerType, customerTypeUsageRange);
                    }
                else {
                    usageRange(returnedAnswer, scanner, customerType, customerTypePhase, fixedCharge);
                    }
                }
            }
    } // Method bracket for wrongInput
